<?xml version="1.0" ?>
<sdf version='1.11'>

  <!-- Defining the world -->
  <world name = "World">
    
    <!-- Defining the inverted pendulum model -->
    <model name="inv_pendulum">

      <!-- Defining the base link  -->
      <link name="base_link">

        <!-- Define the physical properties  -->
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.2</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.2</iyy>
            <iyz>0</iyz>
            <izz>0.15</izz>
          </inertia>
        </inertial>

        <!-- Define the visual properties  -->
        <visual name='base_link_visual'>
          <pose>0 0 1 1.5700000000000001 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 2</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>

        <!-- Left rod for the frame  -->
        <visual name='left_rod'>
          <pose>0 -1 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 1</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>

        <!-- Right rod for the frame  -->
        <visual name='right_rod'>
          <pose>0 1 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 1</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>

        <!-- Closing the base link  -->
      </link>

      <!-- Link for the central piece that actually moves -->
      <link name="central_piece">
        <inertial>
         <pose>0 0 0 0 0 0</pose>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.1</iyy>
            <iyz>0</iyz>
            <izz>0.075</izz>
          </inertia>
        </inertial>
        
        <visual name='central_piece_visual'>
          <pose>0 0 1.06 1.57 0 0</pose>
          <material>
            <diffuse>0 1 0 1</diffuse> <!-- Green color -->
            <ambient>0 1 0 1</ambient> <!-- Green ambient -->
          </material>
          <geometry>
            <box>
              <size>.07 .07 .05</size>
            </box>
          </geometry>
        </visual>

        <collision name='central_piece_collision'>
            <pose>0 0 1.06 1.57 0 0</pose>
            <geometry>
                <box>
                    <size>0.07 0.07 0.05</size>
                </box>
            </geometry>
        </collision>
      </link>

      <!-- Defining the pendulum link  -->
      <link name='pendulum'>
        <pose relative_to='pendulum_joint'>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.01</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.01</iyy>
            <iyz>0</iyz>
            <izz>0.0075</izz>
          </inertia>
        </inertial>

        <visual name='pendulum_visual'>
          <pose>0 0 -0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.3</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 0 0 1</diffuse> <!-- Red color -->
            <ambient>1 0 0 1</ambient> <!-- Red ambient -->
          </material>
        </visual>

        <collision name='pendulum_collision'>
            <pose>0 0 -0.15 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.05 0.05 0.3</size>
                </box>
            </geometry>
        </collision>

        <!-- IMU Sensor -->
        <sensor name='imu_sensor' type='imu'>
          <pose>0 0 0 0 0 0</pose> <!-- Adjust the pose relative to the link -->
          <update_rate>100</update_rate> <!-- Frequency of data updates in Hz -->
          <imu>
            <angular_velocity>
              <x>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </z>
            </angular_velocity>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.01</stddev>
                </noise>
              </z>
            </linear_acceleration>
          </imu>

          <!-- Defining plugin for the transmission of output data  -->
          <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
            <ros>
              <namespace>/pendulum_pose</namespace>
              <remapping>~/imu/data:=imu_data</remapping>
            </ros>
            <output_type>geometry_msgs/Pose</output_type>
            <frameName>pendulum</frameName>
          </plugin>
        </sensor>
      </link>

      <!-- JOINT DEFINITIONS  -->
      <!-- Defining the connection between ground and my frame. -->
      <joint name="base_to_ground" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
      </joint>

      <!-- Defining the prismatic joint  -->
      <joint name='central_piece_joint' type='prismatic'>
        <parent>base_link</parent>
        <child>central_piece</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.9</lower>
            <upper>0.9</upper>
            <effort>10000</effort>
            <velocity>inf</velocity>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      
      <!-- Defining the pendulum joint  -->
      <joint name='pendulum_joint' type='revolute'>
        <pose relative_to='central_piece'>0.06 0 1.06 0 0 0</pose>
        <parent>central_piece</parent>
        <child>pendulum</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-3.14</lower>  <!-- -180 degrees (in radians) -->
            <upper>3.14</upper>   <!-- 180 degrees (in radians) -->
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>10</spring_stiffness>   <!-- Small stiffness -->
            <damping>0.1</damping>                     <!-- Small damping -->
          </dynamics>
        </axis>
      </joint>

      <!-- Defining the plugin for controlling pendulum joint  -->
      <plugin name="gz::sim::systems::JointController" filename="libgz-sim8-joint-controller-system.so">
        <publish_rate>50</publish_rate>
        <joint_name>central_piece_joint</joint_name>
        <topic>/pendulum_joint/command</topic>
      </plugin>

    <!-- Close the model tag -->
    </model>

    <!-- Close the world tag -->
  </world>

<!-- Close the sdf tag -->
</sdf>